# Application
APP_ENV=development
APP_NAME=AI Ecommerce OS

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Shopify (fill these after creating your Shopify store)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=your_shopify_admin_api_token

# Database
DATABASE_URL=sqlite:///data/store.db

# Server
HOST=127.0.0.1
PORT=8000